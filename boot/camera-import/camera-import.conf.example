# Konfiguration für camera-import
# Kopieren nach /boot/config/camera-import/camera-import.conf und ausfüllen.
# Wird von Import-Skript und Bot bei jedem Lauf neu gelesen.

# --- Immich ------------------------------------------------------------------
IMMICH_URL="http://<server-ip>:2283"
IMMICH_API_KEY=""

# --- Telegram ----------------------------------------------------------------
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# --- Album -------------------------------------------------------------------
# none  = kein Album
# fixed = immer IMMICH_ALBUM
# date  = "Import JJJJ-MM-TT"
# ask   = Bot fragt nach dem Namen; ohne Antwort nach ALBUM_ASK_TIMEOUT
#         Sekunden wird wie bei "date" benannt
ALBUM_MODE="ask"
IMMICH_ALBUM=""
ALBUM_ASK_TIMEOUT=120

# --- Import ------------------------------------------------------------------
# NoStack, KeepRaw, KeepJPG, StackCoverRaw, StackCoverJPG
RAW_JPEG="StackCoverJPG"
# 1 = nur simulieren, nichts hochladen
DRY_RUN=0
# 1 = von Unassigned Devices eingehängte Karten nach dem Import aushängen
AUTO_UNMOUNT=1
# Zwischenstände in Prozent, leer = keine
PROGRESS_STEPS="25 50 75"

# --- Stapeln (RAW + HIF/JPG) ------------------------------------------------
# 1 = nach jedem Import RAW- und Bild-Dateien gleichen Namens stapeln
# (immich-go selbst stapelt nur RAW+JPG, nicht RAW+HIF)
STACK_PAIRS=1
# display = HIF/JPG liegt vorne, raw = RAW liegt vorne
STACK_COVER="display"
# Höchster Abstand der Aufnahmezeiten in Sekunden
STACK_TOLERANCE=2

# --- Sonstiges ---------------------------------------------------------------
# 1 = melden, wenn eine neue immich-go-Version erscheint
CHECK_UPDATES=1
